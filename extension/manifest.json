{
  "manifest_version": 3,
  "name": "Corydoras",
  "version": "0.1.0",
  "description": "Adds images and pages to a Corydoras design language with a right-click. Talks only to the Corydoras app on this computer.",
  "icons": { "32": "icons/32.png", "128": "icons/128.png" },
  "permissions": ["contextMenus", "storage", "notifications"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "Corydoras: open the options", "default_icon": { "32": "icons/32.png" } }
}
